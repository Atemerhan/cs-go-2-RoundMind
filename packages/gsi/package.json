{
  "name": "@roundmind/gsi",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only CS2 Game State Integration ingestion for RoundMind.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "mock": "tsx src/cli.ts --mock",
    "install-cfg": "tsx src/install-cfg.ts",
    "test": "vitest run && tsc -p tsconfig.json --noEmit",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
